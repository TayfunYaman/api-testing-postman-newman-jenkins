            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let response = pm.response.json();",
              "",
              "pm.environment.set(\"petId\", response.id);",
              "pm.environment.set(\"categoryId\", response.category.id);",
              "pm.environment.set(\"categoryName\", response.category.name);",
              "pm.environment.set(\"petName\", response.name);",
              "pm.environment.set(\"petphotoUrls\", response.photoUrls);",
              "pm.environment.set(\"petStatus\", response.status);",
